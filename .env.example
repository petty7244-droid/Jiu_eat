# Copy to .env for local development; do not commit real credentials.
# Northflank: enter these as runtime variables, with APP_ENV=production.
APP_ENV=development
PORT=8000
DB_TYPE=postgres
# Copy the existing Render DB_* values to keep the same Supabase database.
DB_HOST=your-supabase-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=replace-with-your-database-password
DB_SSLMODE=require
# Optional for a separately hosted frontend; comma-separated origins, no paths.
# CORS_ORIGINS=https://your-frontend.example.com
